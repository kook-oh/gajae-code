{
  "worx-coordinator": {
    "command": "worx",
    "args": [
      "mcp-serve",
      "coordinator"
    ],
    "env": {
      "WORX_COORDINATOR_MCP_WORKDIR_ROOTS": "${PWD}",
      "WORX_COORDINATOR_MCP_REPO": "worx-code-plugin",
      "WORX_COORDINATOR_MCP_SESSION_COMMAND": "worx --worktree"
    }
  }
}
